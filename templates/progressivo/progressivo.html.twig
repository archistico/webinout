{% extends 'base.html.twig' %}

{% block title %}Progressivo{% endblock %}

{% block body %}
    <div class="row">
        <div class="col-12">
            <h1>PROGRESSIVO</h1>
            <p class="text-secondary">Confronto da inizio anno fino a oggi incluso, con lo stesso periodo dell'anno precedente, nel fuso Europe/Rome.
                Il 29 febbraio viene confrontato con il 28 febbraio se l'anno precedente non è bisestile.</p>
            <p class="text-secondary">Differenza = importo dell'anno in corso meno importo dell'anno precedente.
                Per le uscite, un valore positivo indica una spesa maggiore; un valore negativo indica una spesa minore.</p>
        </div>
    </div>

    {% set sezioni = [
        {titolo: "Progressivo movimenti in entrata rispetto all'anno precedente", tipo: 'entrate', elementi: entrate},
        {titolo: "Progressivo movimenti in uscita rispetto all'anno precedente", tipo: 'uscite', elementi: uscite}
    ] %}
    {% if altre is not empty %}
        {% set sezioni = sezioni|merge([{titolo: 'Progressivo movimenti di altre categorie', tipo: 'altre', elementi: altre}]) %}
    {% endif %}
    {% for sezione in sezioni %}
        <div class="row mt-3">
            <div class="col-12">
                <h2>{{ sezione.titolo }}</h2>
                {% include 'progressivo/_table.html.twig' with sezione %}
            </div>
        </div>
    {% endfor %}

    <div class="row mt-4">
        <div class="col-12">
            <a class="btn btn-secondary btn-square w-100" href="{{ path('app_home') }}">TORNA INDIETRO</a>
        </div>
    </div>
{% endblock %}
