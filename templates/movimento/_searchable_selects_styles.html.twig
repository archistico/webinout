        border-color: var(--tblr-border-color, #374151);
    }
    .movimento-searchable-field .select2-selection--single { min-height: 38px; }
    .movimento-searchable-field .select2-selection--single .select2-selection__rendered {
        color: inherit;
        line-height: 36px;
        padding-left: 12px;
    }
    .movimento-searchable-field .select2-selection--single .select2-selection__arrow { height: 36px; }
